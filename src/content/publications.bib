@inproceedings{11773613,
  author = {Sanchez-Serrano, Pablo and Rios, Ruben and Agudo, Isaac},
  booktitle = {2026 9th International Conference on Networking, Intelligent Systems & Security (NISS)},
  title = {On the Effectiveness of Lightweight Models for Encrypted Traffic Classification},
  year = {2026},
  pages = {215--222},
  abstract = {With the widespread adoption of encryption, encrypted traffic classification has become an essential tool for cybersecurity and network management. Although this problem has been largely addressed using deep learning approaches, the suitability of more computationally efficient models, especially under constrained and high-demand scenarios, remains unclear. This paper presents a systematic experimental study of packet-level encrypted traffic classification that analyzes the impact of lightweight feature engineering and model complexity across heterogeneous datasets. We evaluate sliding window selection and BITization strategies in combination with classical machine learning and deep learning models. We perform a fair comparison across model families and explicitly assess the trade-off between classification performance and computational cost. The results show that well-designed classical machine learning models, particularly tree-based approaches, can match or closely approach the performance of deep learning architectures when paired with appropriate feature representations, while requiring substantially lower computational resources. These findings indicate that, under controlled packet-level input constraints, increasing model complexity yields limited benefits and that feature engineering is a key design factor in practical encrypted traffic classification.},
  keywords = {Modeling, Accuracy, Costing, Niobium, Radio frequency, Windows, Complexity theory, Timing, Machine learning, Training, encrypted traffic classification, traffic analysis, feature engineering, bitization, model complexity, computational cost},
  doi = {10.23919/NISSCPS00007.2026.00037},
  month = {April},
  selected = {true},
  category = {conference paper}
}

@inproceedings{sanchezserrano2025slr,
  author = {Sanchez-Serrano, Pablo and Rios, Ruben and Agudo, Isaac},
  editor = {Garcia-Alfaro, Joaquin and Barker, Ken and Navarro-Arribas, Guillermo and P{\'e}rez-Sol{\`a}, Cristina and Delgado-Segura, Sergi and Katsikas, Sokratis and Cuppens, Fr{\'e}d{\'e}ric and Lambrinoudakis, Costas and Cuppens-Boulahia, Nora and Pawlicki, Marek and Chora{\'{s}}, Micha{\l}},
  title = {Privacy-Preserving Tabular Data Generation: Systematic Literature Review},
  booktitle = {Computer Security. ESORICS 2024 International Workshops},
  year = {2025},
  publisher = {Springer Nature Switzerland},
  address = {Cham},
  pages = {170--180},
  abstract = {There is a wide range of tabular data of great value to science, economy and social progress. When sharing such data, privacy must be taken into account. Traditionally, this has been addressed through anonymization. However, in recent years, with the growth of AI, the possibility of using generative models has emerged as a way to generate synthetic data that guarantees privacy while maintaining their utility. This systematic literature review aims to identify and classify existing privacy-preserving tabular generative models in order to create a taxonomy of solutions. In addition, we analyze the privacy metrics and techniques they use, and identify possible unexplored lines of research.},
  isbn = {978-3-031-82349-7},
  selected = {true},
  category = {conference paper},
  keywords = {synthetic data, privacy, generative models, tabular data, systematic literature review}
}

@article{sanchezserrano2025framework,
  title = {A Decision Framework for Privacy-Preserving Synthetic Data Generation},
  journal = {Computers and Electrical Engineering},
  volume = {126},
  pages = {110468},
  year = {2025},
  issn = {0045-7906},
  doi = {10.1016/j.compeleceng.2025.110468},
  url = {https://www.sciencedirect.com/science/article/pii/S0045790625004112},
  author = {Pablo Sanchez-Serrano and Ruben Rios and Isaac Agudo},
  keywords = {synthetic data, generative models, privacy, utility, metrics, tabular data, taxonomy, framework},
  abstract = {Access to realistic data is essential for various purposes, including training machine learning models, conducting simulations, and supporting data-driven decision making across diverse domains. However, the use of real data often raises significant privacy concerns, as it may contain sensitive or personal information. Generative models have emerged as a promising solution to this problem by generating synthetic datasets that closely resemble real data. Nevertheless, these models are typically trained on original datasets, which carries the risk of leaking sensitive information. To mitigate this issue, privacy-preserving generative models have been developed to balance data utility and privacy guarantees. This paper examines existing generative models for synthetic tabular data generation, proposing a taxonomy of solutions based on the privacy guarantees they provide. Additionally, we present a decision framework to aid in selecting the most suitable privacy-preserving generative model for specific scenarios, using privacy and utility metrics as key selection criteria.},
  selected = {true},
  category = {journal article}
}
