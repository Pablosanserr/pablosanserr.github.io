---
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchAreas } from '../content/research';
---

<BaseLayout
  title="Research"
  description="Research in encrypted traffic analysis and privacy-preserving synthetic data generation."
>
  <header class="page-header container">
    <p class="eyebrow">Research</p><h1>Research at the intersection of AI and privacy.</h1><p
      class="muted"
    >
      I study both how to protect sensitive data in AI systems and how machine learning can reveal
      and help mitigate privacy risks, always under realistic conditions.
    </p>
  </header>
  <div class="areas container">
    {
      researchAreas.map(({ title, question, context, result, publicationId }) => (
        <article data-reveal>
          <h2>{title}</h2>
          <strong>{question}</strong>
          <div class="details">
            <section>
              <h3>Context</h3>
              <p class="muted">{context}</p>
            </section>
            <section>
              <h3>Result</h3>
              <p class="muted">{result}</p>
            </section>
          </div>
          <a
            href={`/publications#publication-${publicationId}`}
            aria-label={`View publication on ${title.toLowerCase()}`}
          >
            View publication
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>
<style>
  .page-header {
    display: grid;
    padding-block: var(--space-9) var(--space-8);
    gap: var(--space-4);
  }
  .page-header h1 {
    max-width: 17ch;
  }
  .page-header > p:last-child {
    max-width: var(--text-width);
    font-size: 1.15rem;
  }
  .areas {
    padding-bottom: var(--space-9);
  }
  article {
    display: grid;
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border);
    justify-items: start;
    gap: var(--space-5);
  }
  strong {
    font-size: 1.15rem;
  }
  .details {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(2, 1fr);
  }
  .details section {
    display: grid;
    gap: var(--space-2);
  }
  h3 {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (max-width: 42rem) {
    .details {
      grid-template-columns: 1fr;
    }
  }
</style>
